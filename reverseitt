        low++;
        high--;

      }

public class Main {

    // Method to reverse the array
    public static void ReversedArray(int[] arr) {
        int low = 0, high = arr.length - 1;
        while (low < high) {
            int temp = arr[low];
            arr[low] = arr[high];
            arr[high] = temp;
            low++;
            high--;
        }
    }

    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5};

        // Reverse the array
        ReversedArray(arr);

        // Print the reversed array
        System.out.print("Reversed array: ");
        for (int i : arr) {
            System.out.print(i + " ");
        }
        System.out.println();
    }
}

